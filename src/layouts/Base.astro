---
import { withBase } from '../lib/base';
import '../styles/global.css';
import EmergencyBar from '../components/EmergencyBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import MobileDock from '../components/MobileDock.astro';
import { site } from '../data/site';

type Props = {
  title: string;
  description: string;
  emergency?: boolean;
  quote?: boolean;
  noCta?: boolean;
};

const { title, description, emergency = false, quote = false, noCta = false } = Astro.props;
const pageTitle = title.includes(site.brand) ? title : `${title} | ${site.brand}`;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Space+Grotesk:wght@500&display=swap"
    />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap" />
  </head>
  <body class:list={['bg-paper', !emergency && !quote && 'pb-[calc(4.25rem+env(safe-area-inset-bottom))] lg:pb-0']}>
    {
      emergency ? (
        <header class="h-[60px] md:h-[72px] flex items-center justify-between px-6 max-w-[1320px] mx-auto">
          <a href={withBase('/')} class="font-display text-[22px] text-ink">
            {site.brand.split(' ')[0]}{' '}
            <span class="font-data text-[11px] text-sea">{site.brand.split(' ')[1]}</span>
          </a>
          <a href={site.phoneTel} class="btn-alert">
            {site.phoneDisplay}
          </a>
        </header>
      ) : quote ? (
        <header class="h-[72px] flex items-center px-6 max-w-[1320px] mx-auto">
          <a href={withBase('/')} class="font-display text-[22px] text-ink">
            {site.brand.split(' ')[0]}{' '}
            <span class="font-data text-[11px] text-sea">{site.brand.split(' ')[1]}</span>
          </a>
        </header>
      ) : (
        <>
          <EmergencyBar />
          <Header />
        </>
      )
    }
    <slot />
    {!emergency && !quote && !noCta && <CtaBand />}
    {!quote && <Footer minimal={emergency} />}
    {!emergency && !quote && <MobileDock />}
  </body>
</html>
