---
import { withBase } from '../lib/base';
import { site, residentialRepair, residentialInstall, commercialLinks } from '../data/site';
import { photos } from '../data/site';
---

<header id="site-header" class="site-header h-[56px] md:h-[72px] bg-paper sticky top-0 z-50">
  <div class="h-full max-w-[1320px] mx-auto px-3 md:px-8 flex items-center justify-between gap-2 md:gap-4 min-w-0">
    <a href={withBase('/')} class="font-display text-[18px] md:text-[22px] text-ink shrink-0 whitespace-nowrap">
      Northlight <span class="font-data text-[10px] md:text-[11px] text-sea">Glass</span>
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-[15px] font-medium" aria-label="Primary">
      <div class="relative" data-mega>
        <button
          class="hover:text-sea"
          type="button"
          aria-expanded="false"
          aria-controls="mega-residential"
          data-mega-toggle
        >
          Residential
        </button>
        <div
          id="mega-residential"
          class="absolute left-0 top-full pt-3 hidden w-[560px]"
          data-mega-panel
        >
          <div class="chamfer bg-paper border border-line grid grid-cols-[1fr_1fr_140px]">
            <div class="p-6 border-r border-line">
              <p class="font-data text-[12px] text-sea mb-3">Repair</p>
              <ul class="space-y-2">
                {residentialRepair.map((l) => (
                  <li><a class="hover:text-sea" href={l.href}>{l.label}</a></li>
                ))}
              </ul>
            </div>
            <div class="p-6">
              <p class="font-data text-[12px] text-sea mb-3">Install</p>
              <ul class="space-y-2">
                {residentialInstall.map((l) => (
                  <li><a class="hover:text-sea" href={l.href}>{l.label}</a></li>
                ))}
              </ul>
            </div>
            <img src={photos.living} alt="" class="w-full h-full object-cover min-h-[180px]" />
          </div>
        </div>
      </div>

      <div class="relative" data-mega>
        <button
          class="hover:text-sea"
          type="button"
          aria-expanded="false"
          aria-controls="mega-commercial"
          data-mega-toggle
        >
          Commercial
        </button>
        <div id="mega-commercial" class="absolute left-0 top-full pt-3 hidden w-[420px]" data-mega-panel>
          <div class="chamfer bg-paper border border-line grid grid-cols-[1fr_140px]">
            <ul class="p-6 space-y-2">
              {commercialLinks.map((l) => (
                <li><a class="hover:text-sea" href={l.href}>{l.label}</a></li>
              ))}
            </ul>
            <img src={photos.storefront} alt="" class="w-full h-full object-cover min-h-[180px]" />
          </div>
        </div>
      </div>

      <a class="hover:text-sea" href={withBase('/services/strata/')}>Strata</a>
      <a class="hover:text-sea" href={withBase('/work/')}>Work</a>
      <a class="text-sea" href={withBase('/contact/')}>Contact</a>
    </nav>

    <div class="flex items-center gap-1.5 md:gap-3 shrink-0">
      <a href={withBase('/emergency/')} class="lg:hidden font-data text-[11px] text-alert px-1">Emergency</a>
      <a href={site.phoneTel} class="btn-call chamfer-sm hidden md:inline-flex py-2.5 px-4 text-[14px]">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B85C1E" stroke-width="1.5" stroke-linecap="square" aria-hidden="true">
          <path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 006 6l1.5-2 4 1.5v3A16 16 0 016.5 3.5z"></path>
        </svg>
        <span class="font-data text-[12px] tracking-[0.08em]">{site.phoneDisplay}</span>
      </a>
      <a href={withBase('/quote/')} class="btn-amber chamfer-sm !px-3 !py-2 md:!px-[17px] md:!py-2.5 text-[13px] md:text-[15px] whitespace-nowrap">
        <span class="sm:hidden">Quote</span>
        <span class="hidden sm:inline">Get a quote</span>
      </a>
      <button
        type="button"
        class="lg:hidden w-11 h-11 flex flex-col justify-center gap-1.5"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        data-drawer-toggle
      >
        <span class="sr-only">Menu</span>
        <span class="block w-5 h-px bg-ink"></span>
        <span class="block w-5 h-px bg-ink"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-drawer" class="hidden lg:hidden fixed inset-0 z-40 bg-paper overflow-y-auto pt-16 p-6">
  <nav class="space-y-6 text-lg font-medium">
    <a class="block" href={withBase('/services/residential/')}>Residential</a>
    <a class="block" href={withBase('/services/commercial/')}>Commercial</a>
    <a class="block" href={withBase('/services/strata/')}>Strata</a>
    <a class="block" href={withBase('/work/')}>Work</a>
    <a class="block" href={withBase('/about/')}>About</a>
    <a class="block text-sea" href={withBase('/contact/')}>Contact</a>
    <a class="block text-alert" href={withBase('/emergency/')}>Emergency</a>
  </nav>
</div>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => {
    header?.classList.toggle('is-stuck', window.scrollY > 80);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.querySelectorAll('[data-mega]').forEach((root) => {
    const toggle = root.querySelector('[data-mega-toggle]');
    const panel = root.querySelector('[data-mega-panel]');
    if (!(toggle instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = panel.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      document.querySelectorAll('[data-mega-panel]').forEach((p) => {
        if (p !== panel) p.classList.add('hidden');
      });
    });
  });
  document.addEventListener('click', () => {
    document.querySelectorAll('[data-mega-panel]').forEach((p) => p.classList.add('hidden'));
    document.querySelectorAll('[data-mega-toggle]').forEach((t) => t.setAttribute('aria-expanded', 'false'));
  });

  const drawer = document.getElementById('mobile-drawer');
  const drawerBtn = document.querySelector('[data-drawer-toggle]');
  drawerBtn?.addEventListener('click', () => {
    const open = drawer?.classList.toggle('hidden') === false;
    drawerBtn.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('overflow-hidden', open);
  });
</script>
