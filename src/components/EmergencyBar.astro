---
import { site } from '../data/site';
---

<div class="bg-alert text-white min-h-[40px] md:h-[46px] flex items-center justify-center gap-3 md:gap-4 px-3 py-2 font-data text-[11px] md:text-[12px]">
  <span class="whitespace-nowrap">Broken glass now?</span>
  <a href={site.phoneTel} class="bg-g-white text-alert px-3 py-1.5 font-sans font-bold tracking-normal normal-case whitespace-nowrap">
    Call {site.phoneDisplay}
  </a>
</div>
