---
import { withBase } from '../lib/base';
import { site } from '../data/site';

type Props = {
  kicker: string;
  heading: string;
  body: string;
  cta?: 'emergency' | 'quote';
};
const { kicker, heading, body, cta = 'quote' } = Astro.props;
---

<div class="chamfer bg-amber-lt p-6 md:p-8">
  <p class="font-data text-[12px] text-sea">{kicker}</p>
  <p class="font-display-m text-[length:var(--text-h3)] mt-2">{heading}</p>
  <p class="mt-3 measure text-[15px]">{body}</p>
  <div class="mt-6 flex flex-col sm:flex-row flex-wrap gap-3">
    {
      cta === 'emergency' ? (
        <a href={withBase('/emergency/')} class="btn-alert chamfer-sm w-full sm:w-auto">
          24/7 emergency
        </a>
      ) : (
        <a href={withBase('/quote/')} class="btn-amber chamfer-sm w-full sm:w-auto">
          Get a quote
        </a>
      )
    }
    <a href={site.phoneTel} class="btn-call chamfer-sm w-full sm:w-auto">Call {site.phoneDisplay}</a>
  </div>
</div>
