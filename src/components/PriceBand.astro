---
import { withBase } from '../lib/base';
import { site } from '../data/site';

type Props = { variant?: 'photo' | 'storefront' };
const { variant = 'photo' } = Astro.props;
---

{
  variant === 'storefront' ? (
    <div class="chamfer bg-amber-lt p-6 md:p-8">
      <p class="font-data text-[12px] text-sea">After hours</p>
      <p class="font-display-m text-[length:var(--text-h3)] mt-2">Board-up tonight. Glass after close.</p>
      <p class="mt-3 measure text-[15px]">
        A broken shopfront shouldn’t cost you a day’s trade. We secure the opening the same night, then replace the
        tempered lite outside business hours so you open on schedule.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row flex-wrap gap-3">
        <a href={withBase('/emergency/')} class="btn-alert chamfer-sm w-full sm:w-auto">24/7 emergency</a>
        <a href={site.phoneTel} class="btn-call chamfer-sm w-full sm:w-auto">Call {site.phoneDisplay}</a>
      </div>
    </div>
  ) : (
    <div class="chamfer bg-amber-lt p-6 md:p-8">
      <p class="font-data text-[12px] text-sea">Photo quote</p>
      <p class="font-display-m text-[length:var(--text-h3)] mt-2">Send a photo. We’ll price it the same day.</p>
      <p class="mt-3 measure text-[15px]">
        Most glass jobs can be quoted from a photograph and two measurements — no site visit for a first price. We’ll
        confirm the actual figure before any work starts.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row flex-wrap gap-3">
        <a href={withBase('/quote/')} class="btn-amber chamfer-sm w-full sm:w-auto">Get a quote</a>
        <a href={site.phoneTel} class="btn-call chamfer-sm w-full sm:w-auto">Call {site.phoneDisplay}</a>
      </div>
    </div>
  )
}
