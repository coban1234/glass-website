---
import { withBase } from '../lib/base';
import { photos } from '../data/site';
import { site } from '../data/site';

type Props = {
  fogged?: string;
  clear?: string;
  caption?: string;
  overlay?: boolean;
};
const {
  fogged = photos.fogged,
  clear = photos.clear,
  caption = 'Fig. 01 — Clear architectural glass · North Shore view',
  overlay = true,
} = Astro.props;
---

<section class="relative defog-root" style="--split: 38%;" data-defog>
  <div
    class:list={[
      'relative overflow-hidden bg-navy touch-pan-y',
      overlay ? 'h-[340px] md:h-[min(100svh,920px)] md:min-h-[560px]' : 'aspect-[3/2] min-h-[240px]',
    ]}
  >
    <img
      src={fogged}
      srcset={fogged.includes('hero-fogged') ? photos.foggedSrcset : undefined}
      sizes="100vw"
      width="5504"
      height="3072"
      fetchpriority={overlay ? 'high' : undefined}
      decoding="async"
      alt="Foggy window with condensation between the panes — failed sealed unit, Metro Vancouver"
      class="absolute inset-0 w-full h-full object-cover object-[70%_center]"
      draggable="false"
    />
    <img
      src={clear}
      srcset={clear.includes('hero-clear') ? photos.clearSrcset : undefined}
      sizes="100vw"
      width="5504"
      height="3072"
      fetchpriority={overlay ? 'high' : undefined}
      decoding="async"
      alt="Clear insulated glass after sealed unit replacement, Metro Vancouver home"
      class="absolute inset-0 w-full h-full object-cover object-[70%_center]"
      data-defog-after
      style="clip-path: inset(0 0 0 var(--split));"
      draggable="false"
    />
    <div
      class="absolute top-0 bottom-0 z-10 w-11 -translate-x-1/2 touch-none"
      style="left: var(--split);"
      data-defog-handle
      role="slider"
      aria-label="Compare fogged and clear glass"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="38"
      tabindex="0"
    >
      <div class="absolute inset-y-0 left-1/2 w-[2px] -translate-x-1/2 bg-sea-lt"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-11 h-11 bg-paper chamfer-sm border border-sea-lt"></div>
    </div>
    <span class="font-data text-[11px] md:text-[12px] text-white absolute top-4 left-4 md:top-6 md:left-8 z-10 pointer-events-none">Fogged</span>
    <span class="font-data text-[11px] md:text-[12px] text-white absolute top-4 right-4 md:top-6 md:right-8 z-10 pointer-events-none">Clear</span>
  </div>

  {
    overlay && (
      <div class="relative z-20 md:absolute md:inset-0 md:flex md:items-center w-full pointer-events-none px-4 md:px-8 lg:px-12 -mt-10 md:mt-0 pb-6 md:py-16">
        <div class="hero-panel pointer-events-auto w-full md:w-[55%] max-w-[720px] bg-navy md:bg-[rgba(15,42,61,0.55)] md:backdrop-blur-[10px] chamfer p-5 sm:p-8 md:p-12 lg:p-16 text-paper">
          <p class="font-data text-[11px] md:text-[12px] text-sea-lt mb-4 md:mb-6">
            Metro Vancouver · Residential · Commercial · Strata
          </p>
          <h1 class="font-display text-[length:var(--text-hero)] text-paper">
            Glass repair in Vancouver — usually without replacing the window.
          </h1>
          <p class="mt-4 md:mt-6 text-[length:var(--text-lead)] font-normal leading-[1.5] measure">
            Foggy sealed units, broken windows, shower glass, and storefronts across Metro Vancouver. When a sealed unit
            fails, the frame is almost always fine. We replace the glass, not the whole window — and it costs a fraction
            of the price.
          </p>
          <div class="mt-6 md:mt-8 flex flex-col sm:flex-row flex-wrap gap-3">
            <span class="focus-wrap w-full sm:w-auto">
              <a href={withBase('/contact/')} class="btn-amber chamfer-sm w-full sm:w-auto">
                Get in touch
              </a>
            </span>
            <a href={site.phoneTel} class="btn-call on-navy chamfer-sm w-full sm:w-auto">
              Call {site.phoneDisplay}
            </a>
          </div>
          <p class="font-data text-[11px] md:text-[12px] text-sea-lt mt-6 md:mt-10">{caption}</p>
        </div>
      </div>
    )
  }
</section>
{!overlay && <p class="font-data text-[13px] text-slate mt-3">{caption}</p>}

<script>
  document.querySelectorAll<HTMLElement>('[data-defog]').forEach((root) => {
    const handle = root.querySelector<HTMLElement>('[data-defog-handle]');
    const after = root.querySelector<HTMLElement>('[data-defog-after]');
    if (!handle || !after) return;

    const setSplit = (pct: number) => {
      const v = Math.max(8, Math.min(92, pct));
      root.style.setProperty('--split', `${v}%`);
      handle.setAttribute('aria-valuenow', String(Math.round(v)));
    };

    const fromEvent = (e: PointerEvent) => {
      const rect = root.getBoundingClientRect();
      return ((e.clientX - rect.left) / rect.width) * 100;
    };

    let dragging = false;
    handle.addEventListener('pointerdown', (e) => {
      dragging = true;
      handle.setPointerCapture(e.pointerId);
      setSplit(fromEvent(e));
    });
    handle.addEventListener('pointermove', (e) => {
      if (dragging) setSplit(fromEvent(e));
    });
    handle.addEventListener('pointerup', () => {
      dragging = false;
    });
    handle.addEventListener('pointercancel', () => {
      dragging = false;
    });
    handle.addEventListener('keydown', (e) => {
      const now = Number(handle.getAttribute('aria-valuenow') || 38);
      if (e.key === 'ArrowLeft') setSplit(now - 5);
      if (e.key === 'ArrowRight') setSplit(now + 5);
      if (e.key === 'Home') setSplit(0);
      if (e.key === 'End') setSplit(100);
    });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const seen = sessionStorage.getItem('defog-hint') === '1';
    if (!reduce && !coarse && !seen) {
      window.setTimeout(() => {
        setSplit(44);
        window.setTimeout(() => {
          setSplit(38);
          sessionStorage.setItem('defog-hint', '1');
        }, 900);
      }, 700);
    }
  });
</script>
