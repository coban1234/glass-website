---
import { withBase } from '../lib/base';
import Base from '../layouts/Base.astro';
import DefogCompare from '../components/DefogCompare.astro';
import SealedExplainer from '../components/SealedExplainer.astro';
import ServiceList from '../components/ServiceList.astro';
import { site, photos, howItWorks, reviews, projects, municipalities } from '../data/site';
---

<Base
  title={`Glass Repair & Replacement Vancouver | Sealed Units, Storefronts, 24/7 | ${site.brand}`}
  description="Glass repair and replacement across Metro Vancouver. Foggy sealed units, broken windows, shower glass, storefronts, and 24/7 emergency board-up."
>
  <DefogCompare />

  <div class="bg-paper border-y border-line py-4">
    <div class="max-w-[1440px] mx-auto px-4 md:px-6 flex flex-wrap items-center justify-center gap-y-2 font-data text-[11px] md:text-[12px] text-ink">
      <span class="px-3 md:px-5">Same-day photo quotes</span>
      <span class="px-3 md:px-5">24/7 emergency response</span>
      <span class="px-3 md:px-5">WorkSafeBC covered & fully insured</span>
      <span class="px-3 md:px-5">★ {site.rating} on Google ({site.reviewCount} reviews)</span>
    </div>
  </div>

  <section class="bg-paper py-16 md:py-24">
    <div class="max-w-[1440px] mx-auto px-6 grid md:grid-cols-3 gap-10">
      <a href={withBase('/services/residential/')} class="flex gap-4 md:border-l-0 border-line">
        <img src={photos.house} alt="Residential glass repair for houses, condos, and townhomes in Metro Vancouver" class="w-12 h-12 object-cover chamfer-sm shrink-0" />
        <div>
          <h2 class="font-data text-[12px] text-sea mb-2">Residential glass repair</h2>
          <p>Foggy sealed units, broken windows, and stuck patio doors — houses, condos, and townhomes.</p>
        </div>
      </a>
      <a href={withBase('/services/commercial/')} class="flex gap-4 md:border-l md:border-line md:pl-8">
        <img src={photos.storefront} alt="Commercial storefront glass repair in Metro Vancouver" class="w-12 h-12 object-cover chamfer-sm shrink-0" />
        <div>
          <h2 class="font-data text-[12px] text-sea mb-2">Commercial glass repair</h2>
          <p>Storefront glass, office entries, and after-hours board-up so you do not close during the day.</p>
        </div>
      </a>
      <a href={withBase('/services/strata/')} class="flex gap-4 md:border-l md:border-line md:pl-8">
        <img src={photos.midrise} alt="Strata glass replacement programs in Metro Vancouver" class="w-12 h-12 object-cover chamfer-sm shrink-0" />
        <div>
          <h2 class="font-data text-[12px] text-sea mb-2">Strata glass replacement</h2>
          <p>Building-wide sealed unit programs, documentation, and rope access for high-rise glass.</p>
        </div>
      </a>
    </div>
  </section>

  <section class="bg-navy text-paper py-20 md:py-28">
    <div class="max-w-[1440px] mx-auto px-6">
      <h2 class="font-display-m text-[length:var(--text-h2)] max-w-[22ch] mb-6">
        Foggy window repair is a sealed unit replacement, not a new window.
      </h2>
      <p class="measure font-normal mb-4">
        A double-pane window is an insulated glass unit: two lites with a sealed, usually argon-filled gap. When the
        perimeter seal fails, moisture condenses between the panes. That is why foggy window repair in Vancouver is an
        IGU swap — cleaning never reaches the cavity.
      </p>
      <p class="measure font-normal mb-12">
        We replace the sealed unit and leave your existing frame in place. Faster and cheaper than full window
        replacement, and in most Metro Vancouver homes the frame still has years of life left.
      </p>
      <SealedExplainer />
      <a href={withBase('/services/residential/foggy-window-sealed-unit-replacement/')} class="link-sea on-navy inline-block mt-10"
        >How it works →</a
      >
    </div>
  </section>

  <section class="bg-paper py-20 md:py-28">
    <div class="max-w-[1440px] mx-auto px-6">
      <ServiceList />
    </div>
  </section>

  <section class="bg-paper py-20 md:py-28 border-t border-line">
    <div class="max-w-[1440px] mx-auto px-6">
      <p class="font-data text-[13px] text-sea mb-12">How glass repair works in Metro Vancouver</p>
      <div class="grid md:grid-cols-4 gap-8">
        {
          howItWorks.map((step) => (
            <div>
              <p class="font-data text-[clamp(4rem,8vw,7rem)] leading-none text-line tracking-tight">{step.n}</p>
              <h3 class="font-bold mt-2">{step.title}</h3>
              <p class="mt-2 text-slate text-[15px]">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-paper py-20 md:py-28 border-t border-line">
    <div class="max-w-[1440px] mx-auto px-6">
      <p class="font-data text-[13px] text-sea mb-8">Glass repair projects in Metro Vancouver</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {
          projects.map((p) => (
            <a href={withBase(`/work/${p.slug}/`)} class="aspect-[4/3] chamfer overflow-hidden opacity-80 hover:opacity-100">
              <img src={p.image} alt={p.title} class="w-full h-full object-cover" />
            </a>
          ))
        }
      </div>
      <a href={withBase('/work/')} class="link-sea inline-block mt-6">All work →</a>
    </div>
  </section>

  <section class="bg-navy text-paper py-20 md:py-28">
    <div class="max-w-[1440px] mx-auto px-6 grid lg:grid-cols-12 gap-10 items-center">
      <img src={photos.apartment} alt="Phased program, 38 units, New Westminster" class="chamfer lg:col-span-4 w-full aspect-[4/5] object-cover" />
      <div class="lg:col-span-8">
        <p class="font-data text-[13px] text-sea-lt mb-4">Strata glass replacement</p>
        <h2 class="font-display-m text-[length:var(--text-h2)]">Strata sealed unit programs with documentation that survives an AGM.</h2>
        <div class="grid md:grid-cols-3 gap-8 mt-10">
          <div>
            <p class="font-data text-[12px] text-sea-lt mb-2">01</p>
            <h3 class="font-bold">One point of contact</h3>
            <p class="mt-2 font-normal">One person owns your building, from the first unit to the last.</p>
          </div>
          <div>
            <p class="font-data text-[12px] text-sea-lt mb-2">02</p>
            <h3 class="font-bold">Documentation that survives an AGM</h3>
            <p class="mt-2 font-normal">Photo records, unit-by-unit scheduling, and invoicing formatted for depreciation reports.</p>
          </div>
          <div>
            <p class="font-data text-[12px] text-sea-lt mb-2">03</p>
            <h3 class="font-bold">Access handled</h3>
            <p class="mt-2 font-normal">Ladder, lift, swing stage, or rope access, with resident notice sent in advance.</p>
          </div>
        </div>
        <a href={withBase('/services/strata/')} class="btn-amber chamfer-sm mt-10 inline-flex">Strata glass replacement →</a>
      </div>
    </div>
  </section>

  <section class="bg-paper py-20 md:py-28">
    <div class="max-w-[1440px] mx-auto px-6">
      <p class="font-data text-[13px] text-sea mb-8">Reviews</p>
      <div class="grid md:grid-cols-3 gap-6">
        {
          reviews.map((r) => (
            <article class="chamfer bg-g-white border border-line p-6">
              <p class="text-amber" aria-label="5 stars">★★★★★</p>
              <p class="mt-3">{r.quote}</p>
              <p class="font-data text-[12px] text-slate mt-4">
                {r.name} · {r.place}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-paper pb-20 px-6 max-w-[1440px] mx-auto">
    <p class="font-data text-[13px] text-sea mb-6">Glass repair service areas</p>
    <ul class="flex flex-wrap gap-3">
      {
        municipalities.map((m) => (
          <li>
            <a href={withBase('/service-areas/')} class="font-data text-[12px] border border-line px-4 py-2 chamfer-sm hover:border-sea">
              {m} glass repair
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
