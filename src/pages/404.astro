---
import { withBase } from '../lib/base';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Page not found" description="That page is broken." noCta>
  <div class="max-w-[800px] mx-auto px-6 py-24">
    <h1 class="font-display text-[length:var(--text-hero)] mb-6">That page is broken. Unlike your glass, we can't fix this one.</h1>
    <ul class="space-y-3 mt-10">
      <li><a class="link-sea" href={withBase('/services/residential/')}>Residential</a></li>
      <li><a class="link-sea" href={withBase('/services/commercial/')}>Commercial</a></li>
      <li><a class="link-sea" href={withBase('/services/strata/')}>Strata</a></li>
      <li><a class="link-sea" href={withBase('/emergency/')}>Emergency</a></li>
      <li><a class="link-sea" href={withBase('/contact/')}>Contact</a></li>
      <li><a href={site.phoneTel}>{site.phoneDisplay}</a></li>
    </ul>
  </div>
</Base>
