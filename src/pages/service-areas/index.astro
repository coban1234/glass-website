---
import Base from '../../layouts/Base.astro';
import { municipalities } from '../../data/site';
---

<Base title="Glass Repair Metro Vancouver | Vancouver, Burnaby, Richmond, Surrey" description="Glass repair across Metro Vancouver: Vancouver, Burnaby, Richmond, North Vancouver, West Vancouver, New Westminster, Surrey, and Coquitlam.">
  <div class="max-w-[1320px] mx-auto px-6 py-20">
    <h1 class="font-display text-[length:var(--text-hero)] mb-6">Glass repair across Metro Vancouver</h1>
    <p class="measure mb-12">
      We replace sealed units, broken windows, shower glass, and storefronts in Vancouver, Burnaby, Richmond, North
      Vancouver, West Vancouver, New Westminster, Surrey, and Coquitlam. Dedicated city pages ship when local photography
      and copy are in.
    </p>
    <ul class="grid md:grid-cols-2 gap-4">
      {
        municipalities.map((m) => (
          <li class="border border-line chamfer p-6">
            <p class="font-display-m text-2xl">{m} glass repair</p>
            <p class="text-slate mt-2">Foggy windows, broken glass, storefronts, and emergency board-up.</p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
