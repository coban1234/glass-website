---
import { withBase } from '../../../lib/base';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { commercialLinks } from '../../../data/site';
---

<Base title="Commercial Glass Repair Vancouver | Storefronts & After Hours" description="Commercial glass repair in Vancouver: storefront glass, door hardware, office partitions, and after-hours board-up across Metro Vancouver.">
  <div class="max-w-[1320px] mx-auto px-6 py-20">
    <Breadcrumbs items={[{ href: withBase('/services/'), label: 'Services' }, { href: withBase('/services/commercial/'), label: 'Commercial' }]} current="Commercial" />
    <h1 class="font-display text-[length:var(--text-hero)] mb-6">Commercial glass repair in Vancouver</h1>
    <p class="measure mb-12">
      Storefront glass repair, commercial door glass, office partitions, and curtain wall replacement — with after-hours
      board-up so a broken lite does not close you during business hours. Metro Vancouver.
    </p>
    <ul class="space-y-4">
      {commercialLinks.map((l) => (
        <li><a class="font-display-m text-2xl hover:text-sea" href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </div>
</Base>
