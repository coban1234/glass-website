---
import { withBase } from '../../../lib/base';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { strataLinks, photos } from '../../../data/site';
---

<Base title="Strata Glass Replacement Vancouver" description="Glass services for strata councils and property managers. Sealed unit programs, documentation, rope access. Metro Vancouver.">
  <div class="max-w-[1320px] mx-auto px-6 py-20">
    <Breadcrumbs items={[{ href: withBase('/services/'), label: 'Services' }, { href: withBase('/services/strata/'), label: 'Strata' }]} current="Strata" />
    <h1 class="font-display text-[length:var(--text-hero)] mb-6">Glass services for strata councils and property managers</h1>
    <p class="measure mb-12">Scheduled programs, documentation, rope access. One point of contact from the first unit to the last.</p>
    <img src={photos.apartment} alt="Phased program, 38 units · New Westminster" class="chamfer w-full max-w-xl aspect-[4/5] object-cover mb-12" />
    <ul class="space-y-4 mb-16">
      {strataLinks.map((l) => (
        <li><a class="font-display-m text-2xl hover:text-sea" href={l.href}>{l.label}</a></li>
      ))}
    </ul>
    <div class="grid md:grid-cols-3 gap-8">
      <div>
        <h2 class="font-bold">One point of contact</h2>
        <p class="mt-2 text-slate">One person owns your building, from the first unit to the last.</p>
      </div>
      <div>
        <h2 class="font-bold">Documentation that survives an AGM</h2>
        <p class="mt-2 text-slate">Photo records, unit-by-unit scheduling, and invoicing formatted for depreciation reports.</p>
      </div>
      <div>
        <h2 class="font-bold">Access handled</h2>
        <p class="mt-2 text-slate">Ladder, lift, swing stage, or rope access, with resident notice sent in advance.</p>
      </div>
    </div>
  </div>
</Base>
