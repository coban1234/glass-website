---
import { withBase } from '../../lib/base';
import Base from '../../layouts/Base.astro';
import { photos } from '../../data/site';
---

<Base
  title="Glass Repair Services Vancouver | Residential, Commercial, Strata"
  description="Glass repair services in Vancouver: foggy sealed units, broken windows, shower glass, storefronts, and strata programs across Metro Vancouver."
>
  <div class="max-w-[1320px] mx-auto px-6 py-20">
    <p class="font-data text-[13px] text-sea mb-4">Metro Vancouver glass repair</p>
    <h1 class="font-display text-[length:var(--text-hero)] mb-6">Glass repair services in Vancouver</h1>
    <p class="measure mb-12">
      Residential, commercial, and strata glass repair and replacement across Metro Vancouver — sealed units, storefronts,
      shower glass, and 24/7 emergency board-up.
    </p>
    <div class="grid md:grid-cols-3 gap-6">
      <a href={withBase('/services/residential/')} class="chamfer bg-g-white border border-line overflow-hidden hover:border-sea">
        <img src={photos.house} alt="Residential glass repair in Metro Vancouver homes" class="w-full aspect-[4/3] object-cover" />
        <div class="p-6">
          <p class="font-data text-[12px] text-sea">Residential glass repair</p>
          <p class="mt-2">Foggy sealed units, broken windows, patio doors, and shower glass for houses, condos, and townhomes.</p>
        </div>
      </a>
      <a href={withBase('/services/commercial/')} class="chamfer bg-g-white border border-line overflow-hidden hover:border-sea">
        <img src={photos.storefront} alt="Commercial storefront glass repair in Vancouver" class="w-full aspect-[4/3] object-cover" />
        <div class="p-6">
          <p class="font-data text-[12px] text-sea">Commercial glass repair</p>
          <p class="mt-2">Storefront glass repair, commercial doors, office partitions, and after-hours board-up.</p>
        </div>
      </a>
      <a href={withBase('/services/strata/')} class="chamfer bg-g-white border border-line overflow-hidden hover:border-sea">
        <img src={photos.midrise} alt="Strata glass replacement in Metro Vancouver buildings" class="w-full aspect-[4/3] object-cover" />
        <div class="p-6">
          <p class="font-data text-[12px] text-sea">Strata glass replacement</p>
          <p class="mt-2">Sealed unit programs, balcony guard glass, and rope access for high-rise buildings.</p>
        </div>
      </a>
    </div>
  </div>
</Base>
