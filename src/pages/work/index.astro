---
import { withBase } from '../../lib/base';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/site';
---

<Base title="Work" description="Recent glass and glazing projects across Metro Vancouver.">
  <div class="max-w-[1320px] mx-auto px-6 py-20">
    <h1 class="font-display text-[length:var(--text-hero)] mb-12">Recent work</h1>
    <div class="grid md:grid-cols-2 gap-4">
      {
        projects.map((p, i) => (
          <a href={withBase(`/work/${p.slug}/`)} class:list={['chamfer overflow-hidden relative group', i === 0 && 'md:col-span-2']}>
            <img src={p.image} alt={p.title} class="w-full object-cover aspect-[3/2] group-hover:opacity-90" />
            <span class="absolute bottom-4 left-4 font-data text-[12px] text-paper bg-navy/70 px-3 py-1">
              {p.title} · {p.location}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
