---
import Base from '../layouts/Base.astro';
---

<Base title="Privacy Policy" description="Privacy policy.">
  <div class="max-w-[720px] mx-auto px-6 py-20">
    <h1 class="font-display text-[length:var(--text-h2)] mb-6">Privacy policy</h1>
    <p class="measure">
      [CLIENT] PIPEDA policy covering collection, purpose, retention, and deletion. Uploaded photos may show a customer's
      property. Gallery use is asked separately on the quote form. CASL consent is unchecked by default.
    </p>
  </div>
</Base>
