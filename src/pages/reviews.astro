---
import Base from '../layouts/Base.astro';
import { reviews, site } from '../data/site';
---

<Base title="Vancouver Glass Repair Reviews | Northlight Glass" description="Google reviews for Northlight Glass — foggy window repair, storefront glass, and emergency board-up across Metro Vancouver.">
  <div class="max-w-[1320px] mx-auto px-6 py-20">
    <h1 class="font-display text-[length:var(--text-hero)] mb-4">Vancouver glass repair reviews</h1>
    <p class="font-data text-[13px] text-slate mb-12">{site.reviewCount} reviews · Metro Vancouver</p>
    <div class="grid md:grid-cols-2 gap-6">
      {
        reviews.map((r) => (
          <article class="chamfer bg-g-white border border-line p-6">
            <p class="text-amber">★★★★★</p>
            <p class="mt-3">{r.quote}</p>
            <p class="font-data text-[12px] text-slate mt-4">
              {r.name} · {r.place}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</Base>
